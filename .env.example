# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection
# If no local or remote MongoDB is reachable, VeriQA automatically launches
# an isolated embedded MongoDB instance for seamless local development out of the box!
MONGODB_URI=mongodb://127.0.0.1:27017/veriqa

# JWT Authentication
JWT_SECRET=veriqa_super_secure_production_secret_key_change_me_in_prod
JWT_EXPIRES_IN=7d

# Client Application URL
CLIENT_ORIGIN=http://localhost:5173

# AI & LLM Provider Configuration (Gemini / OpenAI)
# Optional: If left blank, VeriQA automatically runs the built-in deterministic rule-based
# test generation and failure analysis engine without errors!
LLM_PROVIDER=gemini
LLM_API_KEY=
LLM_MODEL=gemini-1.5-flash

# Execution Worker Constraints
MAX_CONCURRENT_RUNS=3
TEST_TIMEOUT_MS=45000
ALLOW_LOCAL_TESTING=true

# Evidence & Report Storage Path
EVIDENCE_STORAGE_PATH=./evidence
